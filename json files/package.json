{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug auf 8080",
            "url": "http://127.0.0.1:8080",
            "webRoot": "${workspaceFolder}",
            "breakOnLoad": true,
            "sourceMapPathOverrides": {
                "webpack:/*": "${webRoot}/*"
            }
        }
    ]
}
